# ── AP Beauty backend · variables de entorno ──
# Copiar a .env en el servidor y rellenar con valores REALES.
# El .env real NUNCA se versiona (ver .gitignore).

# Clave secreta de Stripe (sk_live_... en producción, sk_test_... en pruebas)
STRIPE_SECRET_KEY=<TU_CLAVE_SECRETA_STRIPE>

# Secreto de firma del webhook (whsec_...), lo da Stripe al crear el endpoint
STRIPE_WEBHOOK_SECRET=<TU_WEBHOOK_SECRET_STRIPE>

# URL pública del sitio (para success_url / cancel_url). Sin barra final.
PUBLIC_BASE_URL=https://apbeauty.com

# Puerto del servidor Express (Nginx hará reverse proxy a este puerto)
PORT=3000
