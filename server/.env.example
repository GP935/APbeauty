# ── AP Beauty backend · variables de entorno ──
# Copiar a .env en el servidor y rellenar con valores REALES.
# El .env real NUNCA se versiona (ver .gitignore).
#
# Moneda única del negocio: PEN (soles). Opera solo en Perú.

# Interruptor de pasarela de pago. Valores: none | stripe | mercadopago
#   none        → checkout apagado; /api/create-checkout-session responde 503
#   stripe      → Stripe Checkout hosted (exige Price IDs REALES creados EN PEN)
#   mercadopago → Card Payment Brick (exige MP_ACCESS_TOKEN válido) — PASARELA ELEGIDA (2026-09-05)
CHECKOUT_GATEWAY=mercadopago

# ── Stripe (dormido hasta CHECKOUT_GATEWAY=stripe) ──
# Los Price objects del dashboard DEBEN estar en PEN para que el importe
# cobrado coincida con el precio en soles que muestra el sitio.
# Clave secreta de Stripe (sk_live_... en producción, sk_test_... en pruebas)
STRIPE_SECRET_KEY=<TU_CLAVE_SECRETA_STRIPE>

# Secreto de firma del webhook (whsec_...), lo da Stripe al crear el endpoint
STRIPE_WEBHOOK_SECRET=<TU_WEBHOOK_SECRET_STRIPE>

# URL pública del sitio (para success_url / cancel_url). Sin barra final.
PUBLIC_BASE_URL=https://apbeauty.com

# Puerto del servidor Express (Nginx hará reverse proxy a este puerto)
PORT=3000

# ── Mercado Pago (pasarela activa — AP-B5) ──
# Access Token secreto (backend). APP_USR-... en producción (NUNCA APP_USR-TEST-...,
# ese prefijo compuesto no es válido). NUNCA es el mismo valor que MP_PUBLIC_KEY
# (esa es pública, va en main.js del frontend).
MP_ACCESS_TOKEN=<TU_ACCESS_TOKEN_MERCADOPAGO>

# Secreto de firma del webhook (se obtiene al crear el endpoint de notificaciones
# en el dashboard de Mercado Pago → Tus integraciones → Webhooks).
# Sin él: los pagos aprobados al instante se confirman igual (respuesta directa de
# la API); solo se pierde la reconciliación de pagos "in_process".
MP_WEBHOOK_SECRET=<TU_WEBHOOK_SECRET_MERCADOPAGO>

# Cliente ID / Cliente secreto (OAuth) — NO se usan en esta integración directa.
# Solo harían falta para marketplace / split payments.
